@model eVote360.WebApp.ViewModels.Auth.LoginViewModel

@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-dark text-white text-center py-4 rounded-top-3">
                    <h3 class="mb-1 fw-bold">
                        <i class="bi bi-person-lock me-2"></i>Acceso al Sistema
                    </h3>
                    <p class="mb-0 small text-light">Administradores y dirigentes políticos</p>
                </div>
                <div class="card-body p-4">
                    
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small"></div>
                    }

                    <form asp-controller="Auth" asp-action="Index" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label asp-for="NombreUsuario" class="form-label fw-semibold text-secondary"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">
                                    <i class="bi bi-person-fill text-muted"></i>
                                </span>
                                <input asp-for="NombreUsuario"
                                       class="form-control form-control-lg"
                                       placeholder="Nombre de usuario"
                                       autocomplete="username"
                                       autofocus />
                            </div>
                            <span asp-validation-for="NombreUsuario" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Password" class="form-label fw-semibold text-secondary">Contraseña</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">
                                    <i class="bi bi-key-fill text-muted"></i>
                                </span>
                                <input asp-for="Password"
                                       class="form-control form-control-lg"
                                       placeholder="Contraseña"
                                       autocomplete="current-password" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="d-flex flex-column flex-sm-row gap-2">
                            <a asp-controller="Elector" asp-action="Index" class="btn btn-secondary btn-lg flex-fill">
                                <i class="bi bi-arrow-left me-1"></i>Volver atrás
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg flex-fill fw-bold shadow-sm">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Iniciar sesión
                            </button>
                        </div>
                    </form>
                </div>
                <div class="card-footer bg-light text-center py-3 rounded-bottom-3 border-top-0">
                    <span class="text-muted small">
                        <i class="bi bi-info-circle me-1"></i>
                        Si es ciudadano elector, regrese al inicio y use su documento de identidad.
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}