@model IEnumerable<eVote360.Core.Application.DTOs.Candidato.CandidatoPuestoDto>

@{
    ViewData["Title"] = "Asignaciones de Candidatos a Puestos";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-person-lines-fill text-primary me-2"></i>Asignaciones de Puestos Electivos</h2>
        <a asp-action="Agregar" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Nueva Asignación
        </a>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white py-3">
            <h6 class="mb-0 fw-bold"><i class="bi bi-list-stars me-2"></i>Lista de Candidatos Asignados a Puestos</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase fs-7">
                        <tr>
                            <th class="ps-4">Foto</th>
                            <th>Candidato</th>
                            <th>Puesto Asignado</th>
                            <th>Origen/Tipo</th>
                            <th>Partido Político</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted small">No hay asignaciones de puestos registradas para este partido.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <img src="@(string.IsNullOrEmpty(item.FotoCandidato) ? "/images/default.png" : item.FotoCandidato)" alt="Candidato" style="width: 45px; height: 45px; border-radius: 50%; object-fit: cover; border: 1px solid #ddd;" />
                                    </td>
                                    <td>
                                        <span class="fw-bold text-dark">@item.NombreCandidato @item.ApellidoCandidato</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary px-3 py-2 rounded-pill fs-7">@item.NombrePuesto</span>
                                    </td>
                                    <td>
                                        <span class="badge @(item.EsAliado ? "bg-info" : "bg-success") px-2 py-1 rounded-3">
                                            @item.TipoCandidatura
                                        </span>
                                    </td>
                                    <td>@item.NombrePartido</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>