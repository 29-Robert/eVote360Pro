@model IEnumerable<eVote360.Core.Domain.Entities.Eleccion>
@using eVote360.Core.Domain.Enums

@{
    ViewData["Title"] = "Gestión de Elecciones";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-gear-fill me-2"></i>Gestión de Procesos Electorales</h2>
        <a asp-action="Crear" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Nueva Elección
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase fs-7">
                        <tr>
                            <th class="ps-4">Proceso Electoral</th>
                            <th>Fecha de Realización</th>
                            <th class="text-center">Estado Actual</th>
                            <th class="text-end pe-4">Acciones / Transición de Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                    No se han registrado procesos electorales en el sistema.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var eleccion in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-dark">@eleccion.Nombre</td>
                                    <td>@eleccion.FechaRealizacion.ToString("dd/MM/yyyy")</td>
                                    <td class="text-center">
                                        @if (eleccion.Estado == EstadoEleccion.Pendiente)
                                        {
                                            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">Pendiente</span>
                                        }
                                        else if (eleccion.Estado == EstadoEleccion.Activa)
                                        {
                                            <span class="badge bg-success px-3 py-2 rounded-pill">Activa</span>
                                        }
                                        else if (eleccion.Estado == EstadoEleccion.Finalizada)
                                        {
                                            <span class="badge bg-secondary px-3 py-2 rounded-pill">Finalizada</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="d-inline-flex gap-2">
                                            @if (eleccion.Estado == EstadoEleccion.Pendiente)
                                            {
                                                <form asp-action="CambiarEstado" method="post" class="m-0">
                                                    <input type="hidden" name="id" value="@eleccion.Id" />
                                                    <input type="hidden" name="nuevoEstado" value="@EstadoEleccion.Activa" />
                                                    <button type="submit" class="btn btn-sm btn-outline-success">
                                                        <i class="bi bi-play-fill me-1"></i> Activar
                                                    </button>
                                                </form>
                                            }
                                            @if (eleccion.Estado == EstadoEleccion.Activa)
                                            {
                                                <form asp-action="CambiarEstado" method="post" class="m-0">
                                                    <input type="hidden" name="id" value="@eleccion.Id" />
                                                    <input type="hidden" name="nuevoEstado" value="@EstadoEleccion.Finalizada" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Está seguro de que desea finalizar este proceso electoral? Esta acción cerrará las votaciones permanentemente.');">
                                                        <i class="bi bi-stop-fill me-1"></i> Finalizar
                                                    </button>
                                                </form>
                                            }
                                            @if (eleccion.Estado == EstadoEleccion.Finalizada)
                                            {
                                                <a asp-controller="Resultados" asp-action="Escrutinio" asp-route-eleccionId="@eleccion.Id" class="btn btn-sm btn-outline-info me-1">
                                                    <i class="bi bi-eye-fill me-1"></i> Resultados
                                                </a>
                                                <button class="btn btn-sm btn-light text-muted" disabled>
                                                    <i class="bi bi-lock-fill"></i> Concluido
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>