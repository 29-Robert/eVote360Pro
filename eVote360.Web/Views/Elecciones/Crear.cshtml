@model eVote360.Core.Domain.Entities.Eleccion

@{
    ViewData["Title"] = "Crear Elección";
}

<div class="container my-5" style="max-width: 600px;">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white py-3">
            <h5 class="card-title mb-0"><i class="bi bi-plus-circle me-2"></i>Registrar Nuevo Proceso Electoral</h5>
        </div>
        <div class="card-body p-4">
            <form asp-action="Crear" method="post">
                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label fw-semibold">Nombre de la Elección</label>
                    <input asp-for="Nombre" class="form-control" placeholder="Ej: Elecciones Presidenciales 2026" required />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="FechaRealizacion" class="form-label fw-semibold">Fecha de Realización</label>
                    <input asp-for="FechaRealizacion" type="date" class="form-control" required />
                    <span asp-validation-for="FechaRealizacion" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn @* Mr. P *@ btn-primary px-4">Guardar Elección</button>
                </div>
            </form>
        </div>
    </div>
</div>