@*    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860*@
@{
}
@model IEnumerable<dynamic>
<!-- Puedes cambiar 'dynamic' por tu DTO real, ej: eVote360.Core.Application.DTOs.Usuarios.UsuarioDto -->

<div class="container mt-4">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark m-0">Usuarios del Sistema</h2>
            <p class="text-muted">Gestión de administradores y dirigentes políticos.</p>
        </div>
        @if (!(ViewBag.IsEleccionActiva ?? false))
        {
            <a asp-action="Create" class="btn btn-primary shadow-sm"><i class="bi bi-plus-circle"></i> Nuevo Usuario</a>
        }
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover table-striped m-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-3">Nombre Completo</th>
                        <th>Usuario</th>
                        <th>Correo</th>
                        <th>Rol</th>
                        <th>Estado</th>
                        <th class="text-center pe-3">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr><td colspan="6" class="text-center py-4 text-muted">No hay usuarios registrados.</td></tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold">@item.Nombre @item.Apellido</td>
                                <td>@item.NombreUsuario</td>
                                <td>@item.CorreoElectronico</td>
                                <td><span class="badge bg-secondary">@item.Rol</span></td>
                                <td>
                                    @if (item.Estado)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Inactivo</span>
                                    }
                                </td>
                                <td class="text-center pe-3">
                                    @if (!(ViewBag.IsEleccionActiva ?? false))
                                    {
                                        <!-- Botón de Editar agregado aquí -->
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <form asp-action="ChangeState" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="hidden" name="state" value="@(item.Estado ? "false" : "true")" />
                                            <button type="submit" class="btn btn-sm @(item.Estado ? "btn-outline-danger" : "btn-outline-success")" onclick="return confirm('¿Cambiar estado del usuario?');">
                                                <i class="bi @(item.Estado ? "bi-toggle-on" : "bi-toggle-off")"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted fs-7"><i class="bi bi-lock-fill"></i> Bloqueado</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>