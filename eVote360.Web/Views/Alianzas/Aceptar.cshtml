@model eVote360.Core.Domain.Entities.SolicitudAlianza

@{
    ViewData["Title"] = "Aceptar Alianza";
}

<div class="container my-5" style="max-width: 600px;">
    <div class="card shadow-sm border-0 border-start border-success border-4">
        <div class="card-header bg-success bg-opacity-10 py-3">
            <h4 class="mb-0 text-success"><i class="bi bi-shield-check me-2"></i>Aceptar Alianza Política</h4>
        </div>
        <div class="card-body p-4 bg-light">
            <p class="fs-5">
                ¿Estás seguro de que deseas aceptar la propuesta de alianza del partido 
                <strong>@(Model.PartidoSolicitante?.Nombre ?? "Cargando...")</strong> (<strong>@(Model.PartidoSolicitante?.Siglas ?? "...")</strong>)?
            </p>
            <div class="alert alert-info small shadow-sm">
                <i class="bi bi-info-circle-fill me-2"></i> Al aceptar esta alianza, podrás compartir candidatos con este partido para puestos electivos de forma conjunta.
            </div>

            <form asp-action="AceptarConfirmado" method="post" class="mt-4">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success w-50">
                        <i class="bi bi-check-circle-fill me-1"></i> Confirmar y Aceptar
                    </button>
                    <a asp-action="Index" class="btn btn-secondary w-50">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>