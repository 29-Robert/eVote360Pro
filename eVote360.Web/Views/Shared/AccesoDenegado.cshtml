@model eVote360.WebApp.ViewModels.Auth.AccesoDenegadoViewModel

@{
    ViewData["Title"] = Model.Titulo;
    Layout = "_Layout";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0 border-start border-danger border-4 rounded-3">
                <div class="card-body text-center p-5">
                    <div class="mb-4">
                        <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-danger-subtle text-danger"
                              style="width: 5rem; height: 5rem;">
                            <i class="bi bi-shield-lock-fill fs-1"></i>
                        </span>
                    </div>

                    <h2 class="fw-bold text-danger mb-3">@Model.Titulo</h2>
                    <p class="text-muted mb-4">@Model.Mensaje</p>

                    <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
                        <a asp-controller="@Model.ControladorDestino"
                           asp-action="@Model.AccionDestino"
                           class="btn btn-primary btn-lg px-4">
                            <i class="bi bi-house-door me-1"></i>@Model.TextoBoton
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>