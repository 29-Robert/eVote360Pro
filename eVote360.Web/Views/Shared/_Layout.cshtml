@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    string accederText = "Acceder";
    string accederController = "Auth";
    string accederAction = "Index";
    string accederIcon = "bi-person-fill";

    if (currentController == "Elector" && currentAction == "Index")
    {
        accederText = "Acceder al Sistema";
        accederController = "Auth";
        accederAction = "Index";
        accederIcon = "bi-person-fill";
    }
    else if (currentController == "Auth" && currentAction == "Index")
    {
        accederText = "Volver al Voto Ciudadano";
        accederController = "Elector";
        accederAction = "Index";
        accederIcon = "bi-arrow-left-circle";
    }
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - eVote360 Pro</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark border-bottom box-shadow mb-4">
            <div class="container">

                
                @if (User.Identity!.IsAuthenticated && User.IsInRole("Administrador"))
                {
                    <a class="navbar-brand fw-bold" asp-area="" asp-controller="Admin" asp-action="Dashboard">
                        <i class="bi bi-shield-check text-primary"></i> eVote360 Pro
                    </a>
                }
                else if (User.Identity!.IsAuthenticated && User.IsInRole("Dirigente político"))
                {
                    <a class="navbar-brand fw-bold" asp-area="" asp-controller="Dirigente" asp-action="Dashboard">
                        <i class="bi bi-shield-check text-primary"></i> eVote360 Pro
                    </a>
                }
                else
                {
                    <a class="navbar-brand fw-bold" asp-area="" asp-controller="Elector" asp-action="Index">
                        <i class="bi bi-shield-check text-primary"></i> eVote360 Pro
                    </a>
                }

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">

                        
                        @if (!User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Elector" asp-action="Index">Inicio Electoral</a>
                            </li>
                        }

                        
                        @if (User.Identity.IsAuthenticated && User.IsInRole("Administrador"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Admin" asp-action="Dashboard">Panel Admin</a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-gear-fill"></i> Mantenimientos
                                </a>
                                <ul class="dropdown-menu shadow" aria-labelledby="navbarDropdown">
                                    <li><a class="dropdown-item" asp-controller="PuestosElectivos" asp-action="Index"><i class="bi bi-diagram-3"></i> Puesto Electivo</a></li>
                                    <li><a class="dropdown-item" asp-controller="Ciudadanos" asp-action="Index"><i class="bi bi-people"></i> Ciudadanos</a></li>
                                    <li><a class="dropdown-item" asp-controller="PartidosPoliticos" asp-action="Index"><i class="bi bi-flag"></i> Partidos políticos</a></li>
                                    <li><a class="dropdown-item" asp-controller="Usuarios" asp-action="Index"><i class="bi bi-person-badge"></i> Usuarios</a></li>
                                    <li><a class="dropdown-item" asp-controller="AsignacionDirigentes" asp-action="Index"><i class="bi bi-person-lines-fill"></i> Asignación de dirigentes</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="Elecciones" asp-action="Index"><i class="bi bi-box-seam"></i> Elecciones</a></li>
                                </ul>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Resultados" asp-action="Resumen">
                                    <i class="bi bi-bar-chart-line-fill"></i> Resumen Electoral
                                </a>
                            </li>
                        }

                        
                        @if (User.Identity.IsAuthenticated && User.IsInRole("Dirigente político"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Dirigente" asp-action="Dashboard">
                                    <i class="bi bi-speedometer2"></i> Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Dirigente" asp-action="MiPartido">
                                    <i class="bi bi-flag-fill"></i> Mi Partido
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Candidatos" asp-action="Index">
                                    <i class="bi bi-people-fill"></i> Candidatos
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Asignaciones" asp-action="Index">
                                    <i class="bi bi-person-badge-fill"></i> Asignaciones
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Alianzas" asp-action="Index">
                                    <i class="bi bi-shield-shaded"></i> Alianzas
                                </a>
                            </li>
                        }
                    </ul>

                    
                    <ul class="navbar-nav">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-light px-3 shadow-sm rounded-pill" asp-controller="Auth" asp-action="Logout">
                                    <i class="bi bi-box-arrow-right me-1"></i> Cerrar Sesión
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-primary fw-bold px-3 shadow-sm rounded-pill" asp-controller="@accederController" asp-action="@accederAction">
                                    <i class="bi @accederIcon me-1"></i> @accederText
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1">
        <main role="main" class="pb-3">
            <partial name="_Notification" /> 
            
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-white mt-auto py-3">
        <div class="container text-center">
            &copy; 2026 - eVote360 Pro - Sistema de Gestión Electoral
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>