@model eVote360.Core.Application.DTOs.Resultado.ResultadoEleccionDto

@{
    ViewData["Title"] = "Escrutinio Electoral";
}

<div class="container my-5">
    <div class="text-center mb-4">
        <h2 class="fw-bold text-dark">
            <i class="bi bi-bar-chart-fill me-2 text-primary"></i>@Model.NombreEleccion
        </h2>
        <p class="text-muted mb-0">
            Resultados oficiales del proceso electoral
            <span class="ms-1">· Finalizado el @Model.FechaFinalizacion.ToString("dd/MM/yyyy HH:mm")</span>
        </p>
    </div>

    <div class="row g-3 mb-5">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="text-muted text-uppercase mb-1">Total de Votos Válidos</h6>
                        <span class="display-6 fw-bold text-primary">@Model.TotalVotosValidos</span>
                    </div>
                    <span class="badge bg-primary fs-5 px-3 py-2 rounded-pill">
                        <i class="bi bi-check2-circle me-1"></i> Válidos
                    </span>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="text-muted text-uppercase mb-1">Votos en Blanco</h6>
                        <span class="display-6 fw-bold text-secondary">@Model.TotalVotosBlanco</span>
                    </div>
                    <span class="badge bg-secondary fs-5 px-3 py-2 rounded-pill">
                        <i class="bi bi-dash-circle me-1"></i> En blanco
                    </span>
                </div>
            </div>
        </div>
    </div>

    <h4 class="mb-4">
        <i class="bi bi-people-fill me-2"></i>Resultados por Candidato
    </h4>

    @if (Model.Candidatos == null || !Model.Candidatos.Any())
    {
        <div class="alert alert-info shadow-sm" role="alert">
            <i class="bi bi-info-circle-fill me-2"></i>
            No hay votos registrados para candidatos en este proceso electoral.
        </div>
    }
    else
    {
        @foreach (var candidato in Model.Candidatos)
        {
            var cardClass = candidato.EsGanador
                ? "card shadow-sm mb-4 border border-success border-3"
                : "card shadow-sm mb-4 border-0";

            var progressBarClass = candidato.EsGanador
                ? "progress-bar bg-success"
                : "progress-bar bg-primary";

            <div class="@cardClass">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                        <div>
                            <h5 class="card-title fw-bold mb-1">@candidato.NombreCompleto</h5>
                            <p class="card-text text-muted mb-0">
                                <i class="bi bi-flag-fill me-1"></i>@candidato.Partido
                                <span class="badge bg-light text-dark border ms-2">@candidato.Siglas</span>
                            </p>
                        </div>
                        @if (candidato.EsGanador)
                        {
                            <span class="badge bg-warning text-dark fs-6 px-3 py-2">
                                🏆 GANADOR
                            </span>
                        }
                    </div>

                    <div class="progress mb-2" style="height: 28px;">
                        <div class="@progressBarClass"
                             role="progressbar"
                             style="width: @(candidato.Porcentaje)%;"
                             aria-valuenow="@candidato.Porcentaje"
                             aria-valuemin="0"
                             aria-valuemax="100">
                        </div>
                    </div>

                    <div class="d-flex justify-content-between text-muted small">
                        <span>
                            <strong class="text-dark">@candidato.Porcentaje.ToString("F2")%</strong>
                        </span>
                        <span>
                            <i class="bi bi-hand-thumbs-up me-1"></i>
                            <strong class="text-dark">@candidato.VotosObtenidos</strong> voto(s)
                        </span>
                    </div>
                </div>
            </div>
        }
    }

    <div class="mt-4">
        <a asp-controller="Elecciones" asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left me-1"></i> Volver a Elecciones
        </a>
    </div>
</div>
