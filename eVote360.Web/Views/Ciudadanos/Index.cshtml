@model IEnumerable<eVote360.WebApp.ViewModels.Ciudadanos.CiudadanoViewModel>

@{
    ViewData["Title"] = "Mantenimiento de Ciudadanos";
    var eleccionActiva = ViewBag.IsEleccionActiva ?? false;
    const string mensajeBloqueo = "No se pueden modificar ciudadanos mientras exista una elección activa.";
}

<div class="container mt-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (eleccionActiva)
    {
        <div class="alert alert-warning border-start border-warning border-4 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>Atención:</strong> @mensajeBloqueo
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark m-0">Mantenimiento de Ciudadanos</h2>
            <p class="text-muted mb-0">Registro y control de electores habilitados para votar.</p>
        </div>
        @if (!eleccionActiva)
        {
            <a asp-action="Create" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Crear ciudadano
            </a>
        }
        else
        {
            <button type="button" class="btn btn-secondary shadow-sm" disabled title="@mensajeBloqueo">
                <i class="bi bi-plus-circle me-1"></i> Crear ciudadano
            </button>
        }
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped m-0 align-middle">
                    <thead class="table-dark text-uppercase fs-7">
                        <tr>
                            <th class="ps-3">Nombre</th>
                            <th>Apellido</th>
                            <th>Correo electrónico</th>
                            <th>Número de documento de identidad</th>
                            <th>Estado</th>
                            <th class="text-center pe-3">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-4 d-block mb-2"></i>
                                    No hay ciudadanos registrados en el sistema.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                var modalActivarId = $"modalActivar{item.Id}";
                                var modalDesactivarId = $"modalDesactivar{item.Id}";

                                <tr>
                                    <td class="ps-3 fw-semibold">@item.Nombre</td>
                                    <td>@item.Apellido</td>
                                    <td>@item.CorreoElectronico</td>
                                    <td>@item.DocumentoIdentidad</td>
                                    <td>
                                        @if (item.Estado)
                                        {
                                            <span class="badge bg-success px-3 py-2 rounded-pill">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary px-3 py-2 rounded-pill">Inactivo</span>
                                        }
                                    </td>
                                    <td class="text-center pe-3">
                                        <div class="d-inline-flex flex-wrap justify-content-center gap-1">
                                            @if (!eleccionActiva)
                                            {
                                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Editar">
                                                    <i class="bi bi-pencil me-1"></i>Editar
                                                </a>

                                                @if (!item.Estado)
                                                {
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-success"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#@modalActivarId">
                                                        Activar
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-danger"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#@modalDesactivarId">
                                                        Desactivar
                                                    </button>
                                                }
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-primary" disabled title="@mensajeBloqueo">
                                                    <i class="bi bi-pencil me-1"></i>Editar
                                                </button>

                                                @if (!item.Estado)
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-success" disabled title="@mensajeBloqueo">
                                                        Activar
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-danger" disabled title="@mensajeBloqueo">
                                                        Desactivar
                                                    </button>
                                                }
                                            }
                                        </div>

                                        @if (!eleccionActiva && !item.Estado)
                                        {
                                            <div class="modal fade" id="@modalActivarId" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-centered">
                                                    <div class="modal-content">
                                                        <div class="modal-header bg-success-subtle">
                                                            <h5 class="modal-title fw-bold">Activar ciudadano</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            ¿Está seguro que desea activar este ciudadano?
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                            <form asp-action="ChangeState" method="post" class="d-inline">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="id" value="@item.Id" />
                                                                <input type="hidden" name="state" value="true" />
                                                                <button type="submit" class="btn btn-success">Aceptar</button>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }

                                        @if (!eleccionActiva && item.Estado)
                                        {
                                            <div class="modal fade" id="@modalDesactivarId" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-centered">
                                                    <div class="modal-content">
                                                        <div class="modal-header bg-danger-subtle">
                                                            <h5 class="modal-title fw-bold">Desactivar ciudadano</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            ¿Está seguro que desea desactivar este ciudadano?
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                            <form asp-action="ChangeState" method="post" class="d-inline">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="id" value="@item.Id" />
                                                                <input type="hidden" name="state" value="false" />
                                                                <button type="submit" class="btn btn-danger">Aceptar</button>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>