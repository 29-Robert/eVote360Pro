@model eVote360.WebApp.ViewModels.PartidosPoliticos.SavePartidoPoliticoViewModel

@{
    ViewData["Title"] = "Registrar Partido Político";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white">
                    <h4 class="m-0"><i class="bi bi-flag-fill me-2"></i>Registrar Partido Político</h4>
                </div>
                <div class="card-body bg-light">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small"></div>

                    
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <div class="row g-3">
                            <div class="col-md-8">
                                <label asp-for="Nombre" class="form-label fw-bold">Nombre del Partido</label>
                                <input asp-for="Nombre" class="form-control" placeholder="Ej. Partido Revolucionario Moderno" required />
                                <span asp-validation-for="Nombre" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Siglas" class="form-label fw-bold">Siglas</label>
                                <input asp-for="Siglas" class="form-control" placeholder="Ej. PRM" required />
                                <span asp-validation-for="Siglas" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12">
                                <label asp-for="Descripcion" class="form-label fw-bold">Descripción</label>
                                <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="Breve descripción del partido..."></textarea>
                                <span asp-validation-for="Descripcion" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12">
                                <label asp-for="LogoFile" class="form-label fw-bold">Logo del Partido</label>
                                <input asp-for="LogoFile" type="file" class="form-control" accept="image/*" required />
                                <div class="form-text">Formatos permitidos: JPG, PNG, WEBP.</div>
                                <span asp-validation-for="LogoFile" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mt-4 d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save me-1"></i>Guardar Partido
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}