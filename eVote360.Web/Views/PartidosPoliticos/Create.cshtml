@model eVote360.WebApp.ViewModels.PartidosPoliticos.SavePartidoPoliticoViewModel

@{
    bool isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? "Editar Partido" : "Crear Partido";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white">
                    <h4 class="m-0"><i class="bi bi-flag-fill"></i> Registrar Partido Político</h4>
                </div>
                <div class="card-body bg-light">
                    <!-- El enctype es OBLIGATORIO para subir imágenes -->
                    <form asp-action="Create" method="post" enctype="multipart/form-data">

                        <div class="row g-3">
                            <div class="col-md-8">
                                <label asp-for="Nombre" class="form-label fw-bold"></label>
                                <input asp-for="Nombre" class="form-control" placeholder="Ej. Partido Revolucionario..." />
                                <span asp-validation-for="Nombre" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Siglas" class="form-label fw-bold"></label>
                                <input asp-for="Siglas" class="form-control" placeholder="Ej. PRM" />
                                <span asp-validation-for="Siglas" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12">
                                <label asp-for="Descripcion" class="form-label fw-bold">Descripción</label>
                                <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Descripcion" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12">
                                <label asp-for="LogoFile" class="form-label fw-bold">Logo del Partido</label>
                                <input asp-for="LogoFile" type="file" class="form-control" accept="image/*" required />
                                <div class="form-text">Formatos permitidos: JPG, PNG, WEBP.</div>
                                <span asp-validation-for="LogoFile" class="text-danger small"></span>
                            </div>
            }
                        </div>

                        <div class="mt-4 d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar Partido</button>
                        </div>

        <button type="submit" class="btn btn-primary">Guardar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}