@model List<eVote360.Core.Application.DTOs.PuestosElectivos.PuestoElectivoDto>

<div class="container mt-4">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (ViewBag.IsEleccionActiva ?? false)
    {
        <div class="alert alert-warning border-start border-warning border-4 shadow-sm">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>Atención:</strong> No se pueden modificar puestos electivos mientras exista una elección activa.
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Mantenimiento de Puestos Electivos</h2>

        @if (!(ViewBag.IsEleccionActiva ?? false))
        {
            <a asp-action="Create" class="btn btn-primary shadow-sm"><i class="bi bi-plus-circle"></i> Nuevo Puesto</a>
        }
        else
        {
            <button class="btn btn-secondary shadow-sm" disabled><i class="bi bi-plus-circle"></i> Nuevo Puesto</button>
        }
    </div>

    <div class="card shadow-sm border-0">
        <table class="table table-hover m-0">
            <thead class="table-dark">
                <tr>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold align-middle">@item.Nombre</td>
                        <td class="align-middle">@item.Descripcion</td>
                        <td class="align-middle">
                            @if (item.Estado)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactivo</span>
                            }
                        </td>
                        <td class="align-middle">
                            @if (!(ViewBag.IsEleccionActiva ?? false))
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Editar"><i class="bi bi-pencil"></i></a>
                                <form asp-action="ChangeState" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="state" value="@(item.Estado ? "false" : "true")" />
                                    <button type="submit" class="btn btn-sm @(item.Estado ? "btn-outline-danger" : "btn-outline-success")" title="@(item.Estado ? "Desactivar" : "Activar")">
                                        <i class="bi @(item.Estado ? "bi-toggle-on" : "bi-toggle-off")"></i>
                                    </button>
                                </form>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary" disabled title="Bloqueado"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-sm btn-outline-secondary" disabled title="Bloqueado"><i class="bi @(item.Estado ? "bi-toggle-on" : "bi-toggle-off")"></i></button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>