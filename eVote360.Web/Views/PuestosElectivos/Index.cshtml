@model List<eVote360.Core.Application.DTOs.PuestosElectivos.PuestoElectivoDto>

<div class="container mt-4">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Mantenimiento de Puestos Electivos</h2>
        @if (!(ViewBag.IsEleccionActiva ?? false))
        {
            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Nuevo Puesto</a>
        }
    </div>

    <div class="card shadow-sm border-0">
        <table class="table table-hover m-0">
            <thead class="table-dark">
                <tr>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">@item.Nombre</td>
                        <td>@item.Descripcion</td>
                        <td>
                            @if (item.Estado)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {

                                <span class="badge bg-danger">Inactivo</span>
                            }
                        </td>
                        <td>
                            @if (!(ViewBag.IsEleccionActiva ?? false))
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i></a>
                                <form asp-action="ChangeState" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="state" value="@(item.Estado ? "false" : "true")" />
                                    <button type="submit" class="btn btn-sm @(item.Estado ? "btn-outline-danger" : "btn-outline-success")">
                                        <i class="bi @(item.Estado ? "bi-toggle-on" : "bi-toggle-off")"></i>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>