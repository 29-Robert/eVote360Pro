@{
    Layout = "_Layout";
    ViewData["Title"] = "Voto Registrado con Éxito";
}

<div class="container mt-5 py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0 rounded-3 p-5 bg-white">
                <div class="mb-4">
                    <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
                </div>
                <h1 class="fw-black text-dark mb-3">¡Voto Depositado exitosamente!</h1>
                <p class="text-muted lead mb-4">Su participación ha sido procesada de manera segura. El sistema ha cerrado su sesión electoral para proteger el anonimato de su voto.</p>
                <div class="d-grid gap-2 col-8 mx-auto">
                    <a asp-controller="Elector" asp-action="Index" class="btn btn-success btn-lg fw-bold rounded-3 py-2 shadow-sm">
                        <i class="bi bi-arrow-left-short me-1"></i>Finalizar y Salir
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>