@{
    Layout = "_Layout";
    ViewData["Title"] = "Fase 2 - Validación por OCR";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-dark text-white text-center py-4 rounded-top-3">
                    <h4 class="mb-1 fw-bold"><i class="bi bi-camera me-2"></i>Verificación de Identidad</h4>
                    <p class="mb-0 small text-muted">Fase 2: Escaneo Facial y de Documento</p>
                </div>
                <div class="card-body p-4 text-center">

                    <div class="alert alert-info text-start small rounded-3" role="alert">
                        <i class="bi bi-info-circle-fill me-2"></i>
                        Para continuar con el proceso de votación, por favor suba una foto clara y legible del frente de su cédula de identidad.
                    </div>

                    <!-- El formulario apunta a la acción del controlador que procesará la imagen -->
                    <form asp-controller="Elector" asp-action="ValidarOcr" method="post" enctype="multipart/form-data" class="mt-4">
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <div class="border-2 border-dashed border-secondary rounded-3 p-5 bg-light position-relative custom-file-upload">
                                <i class="bi bi-cloud-arrow-up display-4 text-secondary d-block mb-3"></i>
                                <label for="fotoCedula" class="form-label fw-bold text-dark">Seleccione o arrastre la foto de su cédula</label>
                                <input type="file" id="fotoCedula" name="fotoCedula" class="form-control mt-2" accept="image/*" required />
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-dark btn-lg fw-bold rounded-3 shadow-sm py-2">
                                <i class="bi bi-cpu me-2"></i>Procesar y Escanear Documento
                            </button>
                            <a asp-controller="Elector" asp-action="Index" class="btn btn-link text-muted btn-sm mt-2">
                                Cancelar y volver al inicio
                            </a>
                        </div>
                    </form>

                </div>
                <div class="card-footer bg-light text-center py-3 rounded-bottom-3 border-top-0">
                    <span class="text-muted small"><i class="bi bi-shield-lock me-1"></i>Los datos escaneados se manejan de manera cifrada y confidencial.</span>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .border-dashed {
        border-style: dashed !important;
    }
</style>