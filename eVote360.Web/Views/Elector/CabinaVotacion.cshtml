@model eVote360.WebApp.ViewModels.Elector.CabinaVotacionViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Cabina de Votación Virtual";
}

<div class="container my-5">
    <div class="text-center mb-5">
        <span class="badge bg-danger text-uppercase px-3 py-2 mb-2 tracking-wider fw-bold">Cabina Virtual Activa</span>
        <h2 class="fw-black text-dark">@Model.NombreEleccion</h2>
    </div>

    @foreach (var partido in Model.Partidos)
    {
        <!-- Aquí al usar @partido.PartidoId, la referencia subirá a 1 -->
        <div class="card shadow-sm border-0 mb-5 rounded-3 overflow-hidden" data-partido-id="@partido.PartidoId">
            <div class="card-header bg-light p-4 border-bottom">
                <h4 class="mb-0 fw-bold text-dark">@partido.NombrePartido (@partido.Siglas)</h4>
            </div>

            <div class="card-body p-4">
                <div class="row g-4 justify-content-center">
                    @foreach (var candidato in partido.Candidatos)
                    {
                        <div class="col-md-4">
                            <div class="card h-100 text-center p-3">
                                <img src="@candidato.Foto" class="card-img-top mx-auto" style="width: 100px; height: 100px;" />
                                <div class="card-body">
                                    <h5 class="fw-bold">@candidato.Nombre @candidato.Apellido</h5>

                                    <form asp-controller="Elector" asp-action="RegistrarVoto" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="candidatoId" value="@candidato.Id" />
                                        <input type="hidden" name="puestoId" value="@candidato.PuestoElectivoId" />
                                        <input type="hidden" name="eleccionId" value="@Model.EleccionId" />

                                        <button type="submit" class="btn btn-outline-dark w-100">
                                            Votar
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <div class="text-center mt-5">
        <form asp-controller="Elector" asp-action="FinalizarVotacion" method="post">
            <input type="hidden" name="eleccionId" value="@Model.EleccionId" />
            <button type="submit" class="btn btn-success btn-lg px-5">Finalizar votación</button>
        </form>
    </div>
</div>