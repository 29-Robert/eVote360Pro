@model eVote360.WebApp.ViewModels.HomeDirigente.HomeDirigenteViewModel
@{
    ViewData["Title"] = "Panel del Dirigente";
}

<div class="container mt-4 animate-fade-in">
    <div class="card shadow-sm border-0 mb-4 card-glass">
        <div class="card-header bg-dark text-white d-flex align-items-center justify-content-between py-3 rounded-top-3">
            <h4 class="m-0 fw-bold">
                <i class="bi bi-speedometer2 me-2"></i> Panel del Dirigente Político
            </h4>
            @if (Model.PartidoActivo)
            {
                <span class="badge bg-success fs-6 rounded-pill px-3">
                    <i class="bi bi-circle-fill me-1" style="font-size:.55rem"></i> Partido activo
                </span>
            }
            else
            {
                <span class="badge bg-danger fs-6 rounded-pill px-3">
                    <i class="bi bi-circle-fill me-1" style="font-size:.55rem"></i> Partido inactivo
                </span>
            }
        </div>
        <div class="card-body bg-light">
            <p class="text-muted mb-0 fs-5">
                Bienvenido, <strong>@Model.NombreCompleto</strong>. 
                Estás gestionando el partido 
                <span class="text-primary fw-bold">@Model.NombrePartido</span> (@Model.SiglasPartido).
            </p>
        </div>
    </div>

    
    <div class="row g-4 mb-4">
        <div class="col-6 col-md-3">
            <div class="card shadow-sm border-0 text-center h-100 kpi-card">
                <div class="card-body bg-white py-4">
                    <div class="fs-1 fw-bold text-primary mb-1">@Model.TotalCandidatos</div>
                    <div class="text-muted small fw-semibold text-uppercase">Candidatos registrados</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card shadow-sm border-0 text-center h-100 kpi-card">
                <div class="card-body bg-white py-4">
                    <div class="fs-1 fw-bold text-success mb-1">@Model.CandidatosActivos</div>
                    <div class="text-muted small fw-semibold text-uppercase">Candidatos activos</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card shadow-sm border-0 text-center h-100 kpi-card">
                <div class="card-body bg-white py-4">
                    <div class="fs-1 fw-bold text-warning mb-1">@Model.AlianzasPendientes</div>
                    <div class="text-muted small fw-semibold text-uppercase">Alianzas pendientes</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card shadow-sm border-0 text-center h-100 kpi-card">
                <div class="card-body bg-white py-4">
                    <div class="fs-1 fw-bold text-info mb-1">@Model.CandidatosAsignados</div>
                    <div class="text-muted small fw-semibold text-uppercase">Candidatos asignados</div>
                </div>
            </div>
        </div>
    </div>

    
    <div class="row g-4">
        
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100 module-card">
                <div class="card-header bg-dark text-white py-3">
                    <h5 class="m-0 fw-bold"><i class="bi bi-flag-fill me-2 text-warning"></i> Mi Partido</h5>
                </div>
                <div class="card-body bg-white d-flex flex-column">
                    <p class="text-muted flex-grow-1">
                        Visualice los datos de su partido político, el logotipo cargado y la nómina completa de sus candidatos postulados.
                    </p>
                    <a asp-controller="Dirigente" asp-action="MiPartido" class="btn btn-outline-dark rounded-pill w-100 mt-auto py-2">
                        <i class="bi bi-eye me-1"></i> Ver Detalles
                    </a>
                </div>
            </div>
        </div>

        
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100 module-card">
                <div class="card-header bg-dark text-white py-3">
                    <h5 class="m-0 fw-bold"><i class="bi bi-people-fill me-2 text-primary"></i> Candidatos</h5>
                </div>
                <div class="card-body bg-white d-flex flex-column">
                    <p class="text-muted flex-grow-1">
                        Inscriba nuevos candidatos, cargue sus imágenes y gestione su estado (Activo/Inactivo) para las elecciones vigentes.
                    </p>
                    <a asp-controller="Candidatos" asp-action="Index" class="btn btn-primary rounded-pill w-100 mt-auto py-2">
                        <i class="bi bi-arrow-right-circle me-1"></i> Gestionar Candidatos
                    </a>
                </div>
            </div>
        </div>

        
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100 module-card">
                <div class="card-header bg-dark text-white py-3">
                    <h5 class="m-0 fw-bold"><i class="bi bi-shield-shaded me-2 text-success"></i> Alianzas</h5>
                </div>
                <div class="card-body bg-white d-flex flex-column">
                    <p class="text-muted flex-grow-1">
                        Proponga coaliciones electorales a partidos contrarios, acepte o rechace pactos y rompa pactos existentes.
                    </p>
                    <a asp-controller="Alianzas" asp-action="Index" class="btn btn-success rounded-pill w-100 mt-auto py-2">
                        <i class="bi bi-arrow-right-circle me-1"></i> Gestionar Alianzas
                    </a>
                </div>
            </div>
        </div>

        
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100 module-card">
                <div class="card-header bg-dark text-white py-3">
                    <h5 class="m-0 fw-bold"><i class="bi bi-person-badge-fill me-2 text-info"></i> Asignaciones</h5>
                </div>
                <div class="card-body bg-white d-flex flex-column">
                    <p class="text-muted flex-grow-1">
                        Asigne candidatos de su propio partido o de alianzas aceptadas a los puestos electivos disponibles.
                    </p>
                    <a asp-controller="Asignaciones" asp-action="Index" class="btn btn-info text-white rounded-pill w-100 mt-auto py-2">
                        <i class="bi bi-arrow-right-circle me-1"></i> Gestionar Asignaciones
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .animate-fade-in {
        animation: fadeIn 0.8s ease-out forwards;
    }
    
    .kpi-card, .module-card {
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
    }

    .kpi-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.05) !important;
    }

    .module-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 30px rgba(0,0,0,0.08) !important;
    }

    .card-glass {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(10px);
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>