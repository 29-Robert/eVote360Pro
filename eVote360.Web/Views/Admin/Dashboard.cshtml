@{
    ViewData["Title"] = "Panel de Control - Administrador";
}

<div class="container my-5 animate-fade-in">
    
    <div class="p-5 mb-5 rounded-4 shadow-lg text-white position-relative overflow-hidden" 
         style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);">
        <div class="position-absolute top-0 end-0 p-5 opacity-10 pointer-events-none">
            <i class="bi bi-shield-check" style="font-size: 15rem; transform: translate(30%, -30%); display: inline-block;"></i>
        </div>
        <div class="position-relative z-3">
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill mb-3">
                <i class="bi bi-lock-fill me-1"></i> Entorno de Administración Seguro
            </span>
            <h1 class="display-4 fw-black tracking-tight mb-2">Panel de Control General</h1>
            <p class="lead text-muted-custom fs-5 mb-0" style="color: #cbd5e1; max-width: 600px;">
                Bienvenido al centro de mando de eVote360 Pro. Aquí podrá gestionar los procesos electorales, configurar candidatos, partidos, usuarios y auditar el sistema en tiempo real.
            </p>
        </div>
    </div>

    
    <div class="card border-0 shadow-sm rounded-4 mb-5 overflow-hidden card-glass">
        <div class="card-body p-4 d-flex flex-column flex-md-row align-items-center justify-content-between">
            <div class="d-flex align-items-center mb-3 mb-md-0">
                <div class="p-3 rounded-4 me-4 bg-primary-subtle text-primary">
                    <i class="bi bi-box-seam fs-2"></i>
                </div>
                <div>
                    <h5 class="fw-bold mb-1">Elección Activa del Sistema</h5>
                    <p class="text-muted mb-0">Proceso electoral en curso que rige el voto de los ciudadanos</p>
                </div>
            </div>
            <div class="text-end">
                @if (ViewBag.ActiveElectionStatus == "Activa")
                {
                    <div class="d-flex align-items-center">
                        <span class="badge bg-success px-4 py-2 fs-6 rounded-pill me-3 position-relative">
                            <span class="position-absolute top-50 start-0 translate-middle-y ms-2 p-1 bg-white border border-light rounded-circle animate-ping"></span>
                            <span class="ms-2">@ViewBag.ActiveElectionStatus</span>
                        </span>
                        <span class="fw-semibold text-dark fs-5">@ViewBag.ActiveElectionName</span>
                    </div>
                }
                else
                {
                    <div class="d-flex align-items-center">
                        <span class="badge bg-secondary px-4 py-2 fs-6 rounded-pill me-3">
                            <i class="bi bi-slash-circle me-1"></i> Inactiva
                        </span>
                        <span class="text-muted fs-6">No hay elecciones en fase activa de votación</span>
                    </div>
                }
            </div>
        </div>
    </div>

    
    <h3 class="fw-bold mb-4 text-dark"><i class="bi bi-activity text-primary me-2"></i> Métricas del Sistema</h3>
    <div class="row g-4 mb-5">
        
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 kpi-card overflow-hidden">
                <div class="card-body p-4 position-relative">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="p-3 rounded-4 bg-blue-subtle text-blue">
                            <i class="bi bi-box-seam fs-3"></i>
                        </div>
                    </div>
                    <h6 class="text-muted fw-semibold mb-1">Procesos Electorales</h6>
                    <h2 class="display-6 fw-bold mb-0">@ViewBag.TotalElections</h2>
                    <div class="mt-2 text-muted small">Registros históricos</div>
                </div>
            </div>
        </div>
        
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 kpi-card overflow-hidden">
                <div class="card-body p-4 position-relative">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="p-3 rounded-4 bg-green-subtle text-green">
                            <i class="bi bi-people fs-3"></i>
                        </div>
                    </div>
                    <h6 class="text-muted fw-semibold mb-1">Ciudadanos</h6>
                    <h2 class="display-6 fw-bold mb-0">@ViewBag.TotalCitizens</h2>
                    <div class="mt-2 text-muted small">Elegibles para votar</div>
                </div>
            </div>
        </div>
        
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 kpi-card overflow-hidden">
                <div class="card-body p-4 position-relative">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="p-3 rounded-4 bg-orange-subtle text-orange">
                            <i class="bi bi-flag fs-3"></i>
                        </div>
                    </div>
                    <h6 class="text-muted fw-semibold mb-1">Partidos Políticos</h6>
                    <h2 class="display-6 fw-bold mb-0">@ViewBag.TotalParties</h2>
                    <div class="mt-2 text-muted small">Partidos inscritos</div>
                </div>
            </div>
        </div>
        
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 kpi-card overflow-hidden">
                <div class="card-body p-4 position-relative">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="p-3 rounded-4 bg-purple-subtle text-purple">
                            <i class="bi bi-person-badge fs-3"></i>
                        </div>
                    </div>
                    <h6 class="text-muted fw-semibold mb-1">Usuarios Registrados</h6>
                    <h2 class="display-6 fw-bold mb-0">@ViewBag.TotalUsers</h2>
                    <div class="mt-2 text-muted small">Admins & Dirigentes</div>
                </div>
            </div>
        </div>
    </div>

    
    <h3 class="fw-bold mb-4 text-dark"><i class="bi bi-gear-wide-connected text-primary me-2"></i> Módulos de Gestión</h3>
    <div class="row g-4">
        
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 module-card overflow-hidden">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="p-3 rounded-4 bg-primary text-white d-inline-flex mb-3 align-self-start shadow-sm">
                        <i class="bi bi-diagram-3 fs-3"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Puestos Electivos</h5>
                    <p class="text-muted flex-grow-1">Configure los cargos públicos a elegir como presidencias, senadurías, diputaciones o alcaldías.</p>
                    <a asp-controller="PuestosElectivos" asp-action="Index" class="btn btn-outline-primary rounded-pill w-100 mt-3 py-2 fw-semibold">
                        <i class="bi bi-arrow-right-short me-1 fs-5"></i> Administrar Puestos
                    </a>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 module-card overflow-hidden">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="p-3 rounded-4 bg-success text-white d-inline-flex mb-3 align-self-start shadow-sm">
                        <i class="bi bi-people fs-3"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Padrón de Ciudadanos</h5>
                    <p class="text-muted flex-grow-1">Gestione el padrón electoral de electores habilitados y valide su estado de participación.</p>
                    <a asp-controller="Ciudadanos" asp-action="Index" class="btn btn-outline-success rounded-pill w-100 mt-3 py-2 fw-semibold">
                        <i class="bi bi-arrow-right-short me-1 fs-5"></i> Administrar Ciudadanos
                    </a>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 module-card overflow-hidden">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="p-3 rounded-4 bg-warning text-white d-inline-flex mb-3 align-self-start shadow-sm">
                        <i class="bi bi-flag fs-3"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Partidos Políticos</h5>
                    <p class="text-muted flex-grow-1">Inscriba organizaciones políticas, gestione sus siglas y configure sus logotipos oficiales.</p>
                    <a asp-controller="PartidosPoliticos" asp-action="Index" class="btn btn-outline-warning rounded-pill w-100 mt-3 py-2 fw-semibold">
                        <i class="bi bi-arrow-right-short me-1 fs-5"></i> Administrar Partidos
                    </a>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 module-card overflow-hidden">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="p-3 rounded-4 bg-info text-white d-inline-flex mb-3 align-self-start shadow-sm">
                        <i class="bi bi-person-badge fs-3"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Usuarios del Sistema</h5>
                    <p class="text-muted flex-grow-1">Gestione los perfiles de acceso administrativo y de dirigentes políticos.</p>
                    <a asp-controller="Usuarios" asp-action="Index" class="btn btn-outline-info rounded-pill w-100 mt-3 py-2 fw-semibold">
                        <i class="bi bi-arrow-right-short me-1 fs-5"></i> Administrar Usuarios
                    </a>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 module-card overflow-hidden">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="p-3 rounded-4 bg-purple text-white d-inline-flex mb-3 align-self-start shadow-sm">
                        <i class="bi bi-person-lines-fill fs-3"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Asignación de Dirigentes</h5>
                    <p class="text-muted flex-grow-1">Asigne dirigentes de partidos para que puedan gestionar candidatos y alianzas autónomamente.</p>
                    <a asp-controller="AsignacionDirigentes" asp-action="Index" class="btn btn-outline-purple rounded-pill w-100 mt-3 py-2 fw-semibold">
                        <i class="bi bi-arrow-right-short me-1 fs-5"></i> Asignar Dirigentes
                    </a>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 module-card overflow-hidden">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="p-3 rounded-4 bg-danger text-white d-inline-flex mb-3 align-self-start shadow-sm">
                        <i class="bi bi-box-seam fs-3"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Elecciones y Procesos</h5>
                    <p class="text-muted flex-grow-1">Planifique, active o finalice procesos electorales generales e invoque el escrutinio.</p>
                    <a asp-controller="Elecciones" asp-action="Index" class="btn btn-outline-danger rounded-pill w-100 mt-3 py-2 fw-semibold">
                        <i class="bi bi-arrow-right-short me-1 fs-5"></i> Gestionar Elecciones
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    
    .animate-fade-in {
        animation: fadeIn 0.8s ease-out forwards;
    }
    
    .tracking-tight {
        letter-spacing: -0.025em;
    }

    .fw-black {
        font-weight: 900;
    }

    .bg-blue-subtle { background-color: rgba(30, 144, 255, 0.1); }
    .text-blue { color: #1e90ff; }
    .bg-green-subtle { background-color: rgba(46, 204, 113, 0.1); }
    .text-green { color: #2ecc71; }
    .bg-orange-subtle { background-color: rgba(230, 126, 34, 0.1); }
    .text-orange { color: #e67e22; }
    .bg-purple-subtle { background-color: rgba(155, 89, 182, 0.1); }
    .text-purple { color: #9b59b6; }
    .bg-primary-subtle { background-color: rgba(13, 110, 253, 0.15); }

    .btn-outline-purple {
        color: #9b59b6;
        border-color: #9b59b6;
    }
    .btn-outline-purple:hover {
        background-color: #9b59b6;
        color: #fff;
    }

    .bg-purple { background-color: #9b59b6; }

    
    .kpi-card, .module-card {
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
        background-color: #ffffff;
    }

    .kpi-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.05) !important;
    }

    .module-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 30px rgba(0,0,0,0.08) !important;
    }

    .card-glass {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.5);
    }

    .animate-ping {
        animation: ping 1.5s cubic-bezier(0, 0, 0.2, 1) infinite;
    }

    @@keyframes ping {
        75%, 100% {
            transform: scale(2);
            opacity: 0;
        }
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>