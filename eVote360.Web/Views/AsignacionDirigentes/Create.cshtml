@model eVote360.WebApp.ViewModels.AsignacionDirigentes.SaveAsignacionViewModel
@{
    var usuariosList = ViewBag.Usuarios as SelectList;
    var partidosList = ViewBag.Partidos as SelectList;
    bool noUsuarios = usuariosList == null || !usuariosList.Any();
    bool noPartidos = partidosList == null || !partidosList.Any();
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white">
                    <h4 class="m-0"><i class="bi bi-link-45deg"></i> Asignar Dirigente a Partido</h4>
                </div>
                <div class="card-body bg-light">
                    @if (noUsuarios || noPartidos)
                    {
                        <div class="alert alert-warning border-0 shadow-sm rounded-3 mb-4">
                            <h6 class="fw-bold"><i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>Restricción de Negocio</h6>
                            <ul class="mb-0 ps-3 small text-muted">
                                @if (noUsuarios)
                                {
                                    <li>No hay dirigentes políticos activos y <strong>desocupados</strong> disponibles en el sistema. Debe registrar un nuevo dirigente en <a asp-controller="Usuarios" asp-action="Index" class="fw-bold">Mantenimiento de Usuarios</a>.</li>
                                }
                                @if (noPartidos)
                                {
                                    <li>No hay partidos políticos activos y <strong>desocupados</strong> disponibles. Debe registrar o activar un partido en <a asp-controller="PartidosPoliticos" asp-action="Index" class="fw-bold">Mantenimiento de Partidos</a>.</li>
                                }
                            </ul>
                        </div>
                    }

                    <form asp-action="Create" method="post">

                        <div class="mb-3">
                            <label asp-for="UsuarioId" class="form-label fw-bold">Dirigente Político</label>
                            <select asp-for="UsuarioId" asp-items="ViewBag.Usuarios" class="form-select">
                                <option value="">-- Seleccione un dirigente disponible --</option>
                            </select>
                            <span asp-validation-for="UsuarioId" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="PartidoPoliticoId" class="form-label fw-bold">Partido Político</label>
                            <select asp-for="PartidoPoliticoId" asp-items="ViewBag.Partidos" class="form-select">
                                <option value="">-- Seleccione un partido político disponible --</option>
                            </select>
                            <span asp-validation-for="PartidoPoliticoId" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Crear Asignación</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}