@model IEnumerable<eVote360.Core.Application.DTOs.Asignaciones.AsignacionDirigenteDto>

<div class="container mt-4">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark m-0">Asignación de Dirigentes Políticos</h2>
            <p class="text-muted">Relación uno a uno entre usuarios dirigentes y partidos políticos.</p>
        </div>
        @if (!(ViewBag.IsEleccionActiva ?? false))
        {
            <a asp-action="Create" class="btn btn-primary shadow-sm"><i class="bi bi-plus-circle"></i> Agregar Asignación</a>
        }
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover table-striped m-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-3">Dirigente Político</th>
                        <th>Nombre de Usuario</th>
                        <th>Partido Asignado</th>
                        <th>Siglas</th>
                        <th class="text-center pe-3">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr><td colspan="5" class="text-center py-4 text-muted">No hay asignaciones registradas.</td></tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold">@item.NombreDirigente</td>
                                <td>@item.NombreUsuario</td>
                                <td>@item.NombrePartido</td>
                                <td><span class="badge bg-primary">@item.SiglasPartido</span></td>
                                <td class="text-center pe-3">
                                    @if (!(ViewBag.IsEleccionActiva ?? false))
                                    {
                                        <form asp-action="Delete" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Está seguro que desea desvincular este dirigente político de este partido?');">
                                                <i class="bi bi-trash-fill"></i> Eliminar relación
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted fs-7"><i class="bi bi-lock-fill"></i> Bloqueado</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>